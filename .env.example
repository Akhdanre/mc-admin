# Minecraft Server RCON Configuration
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password_here
RCON_TIMEOUT_MS=5000

# Live Web Map URL (e.g. Dynmap / BlueMap)
NEXT_PUBLIC_MAP_URL=http://localhost:8123

# Optional: Custom mount paths (defaults to /data and /backups in Docker)
# MC_DATA_PATH=/data
# MC_BACKUPS_PATH=/backups
