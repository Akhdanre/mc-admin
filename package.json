{
  "name": "mc-dashboard",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run index.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "rcon-client": "^4.2.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
